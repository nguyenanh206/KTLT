def addNode(head, new_data):
    """
    Vì Python không có tham chiếu biến (như Node* &head),
    hàm này sẽ trả về head mới để gán lại.
    VD: head = addNode(head, new_transaction)
    """
    new_node = Node(new_data)

    if head is None:
        return new_node

    temp = head
    while temp.next is not None:
        temp = temp.next

    temp.next = new_node
    return head


def deleteNode(head, id_to_delete):
    """
    Trả về một tuple gồm: (head_mới, kết_quả_xoá_thành_công_hay_không)
    VD: head, success = deleteNode(head, "GD01")
    """
    if head is None:
        return head, False

    temp = head

    # Trường hợp Node cần xoá nằm ngay đầu danh sách (head)
    if temp is not None and temp.data.id == id_to_delete:
        head = temp.next
        return head, True

    prev = None
    # Tìm Node cần xoá
    while temp is not None and temp.data.id != id_to_delete:
        prev = temp
        temp = temp.next

    # Nếu không tìm thấy
    if temp is None:
        return head, False

    # Xoá Node bằng cách bỏ qua nó trong liên kết
    prev.next = temp.next
    return head, True


